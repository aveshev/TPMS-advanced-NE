<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <!-- https://developer.android.com/about/versions/14/changes/fgs-types-required#connected-device -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />

    <!-- For the "suspend scanning on WiFi" setting: ConnectivityManager itself needs no runtime
         prompt, but identifying the currently-connected SSID (for the per-network exception) does. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Unredacting the connected SSID (via WifiManager or NetworkCapabilities +
         FLAG_INCLUDE_LOCATION_INFO alike) requires ACCESS_FINE_LOCATION specifically, on every
         API level — NEARBY_WIFI_DEVICES does not unlock it, confirmed on-device on API 37. Coarse
         must be declared alongside it: from API 31, the user picks between the two. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The service reads the connected SSID while the app is not visible (in the background,
         after a boot): "while using the app" is not enough for that. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application>
        <receiver android:name="com.masselis.tpmsadvanced.feature.background.interfaces.DisableMonitorBroadcastReceiver" />
        <receiver android:name="com.masselis.tpmsadvanced.feature.background.interfaces.RestartAppBroadcastReceiver" />
        <!-- Exported so the system can reach it; both actions are protected broadcasts only the system can send -->
        <receiver
            android:name="com.masselis.tpmsadvanced.feature.background.interfaces.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- https://developer.android.com/about/versions/14/changes/fgs-types-required#connected-device -->
        <service
            android:name="com.masselis.tpmsadvanced.feature.background.interfaces.MonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>