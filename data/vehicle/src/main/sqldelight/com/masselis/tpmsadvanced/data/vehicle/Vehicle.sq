SELECT separateRearPressure FROM Vehicle WHERE uuid = ?;

updateSeparateRearPressure:
UPDATE Vehicle SET separateRearPressure = ? WHERE uuid = ?;

selectSpareLowPressureByVehicleId:
SELECT spareLowPressure FROM Vehicle WHERE uuid = ?;

updateSpareLowPressure:
UPDATE Vehicle SET spareLowPressure = ? WHERE uuid = ?;

selectSpareHighPressureByVehicleId:
SELECT spareHighPressure FROM Vehicle WHERE uuid = ?;

updateSpareHighPressure:
UPDATE Vehicle SET spareHighPressure = ? WHERE uuid = ?;

selectSeparateSparePressureByVehicleId:
SELECT separateSparePressure FROM Vehicle WHERE uuid = ?;

updateSeparateSparePressure:
UPDATE Vehicle SET separateSparePressure = ? WHERE uuid = ?;

selectLowBatteryVoltageByVehicleId:
SELECT lowBatteryVoltage FROM Vehicle WHERE uuid = ?;

updateLowBatteryVoltage:
UPDATE Vehicle SET lowBatteryVoltage = ? WHERE uuid = ?;

selectLowBatteryPercentByVehicleId:
SELECT lowBatteryPercent FROM Vehicle WHERE uuid = ?;

updateLowBatteryPercent:
UPDATE Vehicle SET lowBatteryPercent = ? WHERE uuid = ?;

selectLowTempByVehicleId:
SELECT lowTemp FROM Vehicle WHERE uuid = ?;

updateLowTemp:
UPDATE Vehicle SET lowTemp = ? WHERE uuid = ?;

selectNormalTempByVehicleId:
SELECT normalTemp FROM Vehicle WHERE uuid = ?;

updateNormalTemp:
UPDATE Vehicle SET normalTemp = ? WHERE uuid = ?;

selectHighTempByVehicleId:
SELECT highTemp FROM Vehicle WHERE uuid = ?;

updateHighTemp:
UPDATE Vehicle SET highTemp = ? WHERE uuid = ?;

updateIsDeleting:
UPDATE Vehicle SET isDeleting = ? WHERE uuid = ?;

deleteIsDeleting:
DELETE FROM Vehicle WHERE isDeleting = 1;

delete:
DELETE FROM Vehicle WHERE uuid = ?;

setAsFavourite:
UPDATE Vehicle SET isFavourite = ? WHERE uuid = ?;

currentFavourite:
SELECT * FROM Vehicle WHERE isFavourite = 1 AND isDeleting = 0;

selectUuidIsDeleting:
SELECT uuid FROM Vehicle WHERE isDeleting = 1;

selectAll:
SELECT * FROM Vehicle WHERE isDeleting = 0;

count:
SELECT count(uuid) FROM Vehicle WHERE isDeleting = 0;

selectByUuid:
SELECT * FROM Vehicle WHERE uuid = ? AND isDeleting = 0;

selectBySensorId:
SELECT Vehicle.* FROM Vehicle
INNER JOIN Sensor ON Sensor.vehicleId = Vehicle.uuid
WHERE Sensor.id = ? AND isDeleting = 0;