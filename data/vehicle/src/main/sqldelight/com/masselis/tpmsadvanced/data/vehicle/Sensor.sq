import com.masselis.tpmsadvanced.data.vehicle.model.Pressure;
import com.masselis.tpmsadvanced.data.vehicle.model.SensorBrand;
import com.masselis.tpmsadvanced.data.vehicle.model.Vehicle;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE Sensor(
    id INTEGER AS Int NOT NULL PRIMARY KEY,
    location INTEGER AS Vehicle.Kind.Location NOT NULL,
    vehicleId BLOB AS UUID NOT NULL,
    brand INTEGER AS SensorBrand NOT NULL,
    -- Its calibration, it's the sensor which reads too high or too low. Kept when it's moved or
    -- swapped on its vehicle, deleted with it.
    pressureCalibration INTEGER AS Boolean NOT NULL DEFAULT 0,
    pressureOffset REAL AS Pressure NOT NULL DEFAULT 0,
    pressureMultiplier REAL NOT NULL DEFAULT 1,
    FOREIGN KEY(vehicleId) REFERENCES Vehicle(uuid) ON DELETE CASCADE,
    UNIQUE(location, vehicleId)
);

/**
Insert the sensor. If the sensor already exists in the database, this instruction moves the sensor
from the previous car and set it into the new car. Its own calibration was made for the previous
car's wheels, it's dropped there.
*/
upsert:
INSERT INTO Sensor (id, location, vehicleId, brand)
VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO
UPDATE SET
    location=excluded.location,
    brand=excluded.brand,
    pressureCalibration=CASE WHEN vehicleId = excluded.vehicleId THEN pressureCalibration ELSE 0 END,
    pressureOffset=CASE WHEN vehicleId = excluded.vehicleId THEN pressureOffset ELSE 0 END,
    pressureMultiplier=CASE WHEN vehicleId = excluded.vehicleId THEN pressureMultiplier ELSE 1 END,
    vehicleId=excluded.vehicleId;

deleteByVehicle:
DELETE FROM Sensor WHERE rowid IN (
    SELECT Sensor.rowid FROM Sensor
    INNER JOIN Vehicle ON Sensor.vehicleId = Vehicle.uuid
    WHERE Vehicle.uuid = ?
);

deleteByVehicleAndLocation:
DELETE FROM Sensor WHERE vehicleId = ? AND location = ?;

selectByVehicleAndLocation:
SELECT Sensor.* FROM Sensor
INNER JOIN Vehicle ON Sensor.vehicleId = Vehicle.uuid
WHERE Vehicle.uuid = ? AND location = ?;

countByVehicle:
SELECT COUNT(Sensor.rowid) FROM Sensor
INNER JOIN Vehicle ON Sensor.vehicleId = Vehicle.uuid
WHERE Vehicle.uuid = ?;

selectById:
SELECT * FROM Sensor WHERE Sensor.id = ?;

selectListByVehicleId:
SELECT * FROM Sensor WHERE Sensor.vehicleId = ?;

selectListExcludingVehicleId:
SELECT * FROM Sensor WHERE Sensor.vehicleId != ?;

-- What the vehicle's battery alarms apply to, see SensorBrand.batteryUnit
brandsByVehicleId:
SELECT DISTINCT brand FROM Sensor WHERE vehicleId = ?;

-- The calibrations of a vehicle's sensors, see Vehicle.sharedCalibration
selectCalibrationsByVehicleId:
SELECT id, pressureCalibration, pressureOffset, pressureMultiplier FROM Sensor WHERE vehicleId = ?;

selectCalibrationById:
SELECT pressureCalibration, pressureOffset, pressureMultiplier FROM Sensor WHERE id = ?;

updateCalibration:
UPDATE Sensor SET pressureCalibration = ?, pressureOffset = ?, pressureMultiplier = ? WHERE id = ?;

-- Sets every sensor of a vehicle to the same calibration, when it stops being shared or starts
updateCalibrationsByVehicleId:
UPDATE Sensor SET pressureCalibration = ?, pressureOffset = ?, pressureMultiplier = ? WHERE vehicleId = ?;
