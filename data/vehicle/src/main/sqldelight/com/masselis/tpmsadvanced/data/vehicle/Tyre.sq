import com.masselis.tpmsadvanced.data.vehicle.model.Pressure;
import com.masselis.tpmsadvanced.data.vehicle.model.Vehicle;
import com.masselis.tpmsadvanced.data.vehicle.model.Temperature;
import com.masselis.tpmsadvanced.data.vehicle.model.Voltage;
import java.util.UUID;
import kotlin.Boolean;
import kotlin.Int;
import kotlin.UShort;

CREATE TABLE Tyre(
    id INTEGER AS Int NOT NULL,
    timestamp REAL NOT NULL,
    rssi INTEGER AS Int NOT NULL,
    location INTEGER AS Vehicle.Kind.Location NOT NULL,
    pressure REAL AS Pressure NOT NULL,
    temperature REAL AS Temperature NOT NULL,
    battery INTEGER AS UShort NOT NULL,
    isAlarm INTEGER AS Boolean NOT NULL,
    vehicleId TEXT AS UUID NOT NULL,
    batteryVoltage REAL AS Voltage,
    -- The whole advertisement in hexadecimal, for what the decoders don't read yet, the flags
    -- shown on the tyres included
    raw TEXT,
    -- Sysgration's battery, in percent, null for the other sensors
    batteryPercent INTEGER AS Int,
    FOREIGN KEY(vehicleId) REFERENCES Vehicle(uuid) ON DELETE CASCADE
);

-- The readings are only ever looked up by tyre, the latest ones first
CREATE INDEX IF NOT EXISTS tyre_vehicle_location_timestamp ON Tyre(vehicleId, location, timestamp);

insert:
INSERT INTO Tyre (id, timestamp, rssi, location, pressure, temperature, battery, isAlarm, vehicleId, batteryVoltage, raw, batteryPercent) VALUES (?, ?,?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

latestByTyreLocationByVehicle:
SELECT Tyre.id, Tyre.timestamp, Tyre.rssi, Tyre.location, Tyre.pressure, Tyre.temperature, Tyre.battery, Tyre.isAlarm, Tyre.batteryVoltage, Tyre.raw, Tyre.batteryPercent FROM Tyre
INNER JOIN Vehicle ON Tyre.vehicleId = Vehicle.uuid
WHERE location = ? AND Vehicle.uuid = ?
ORDER BY timestamp DESC
LIMIT 1;

latestBySensorByTyreLocationByVehicle:
SELECT Tyre.id, Tyre.timestamp, Tyre.rssi, Tyre.location, Tyre.pressure, Tyre.temperature, Tyre.battery, Tyre.isAlarm, Tyre.batteryVoltage, Tyre.raw, Tyre.batteryPercent FROM Tyre
INNER JOIN Vehicle ON Tyre.vehicleId = Vehicle.uuid
WHERE Tyre.id = ? AND location = ? AND Vehicle.uuid = ?
ORDER BY timestamp DESC
LIMIT 1;

allByTyreLocationByVehicle:
SELECT Tyre.id, Tyre.timestamp, Tyre.rssi, Tyre.location, Tyre.pressure, Tyre.temperature, Tyre.battery, Tyre.isAlarm, Tyre.batteryVoltage, Tyre.raw, Tyre.batteryPercent FROM Tyre
INNER JOIN Vehicle ON Tyre.vehicleId = Vehicle.uuid
WHERE location = ? AND Vehicle.uuid = ?
ORDER BY timestamp ASC;

afterByTyreLocationByVehicle:
SELECT Tyre.id, Tyre.timestamp, Tyre.rssi, Tyre.location, Tyre.pressure, Tyre.temperature, Tyre.battery, Tyre.isAlarm, Tyre.batteryVoltage, Tyre.raw, Tyre.batteryPercent FROM Tyre
WHERE vehicleId = ? AND location = ? AND timestamp > ?
ORDER BY timestamp ASC;

countByTyreLocationByVehicle:
SELECT COUNT(*) FROM Tyre WHERE vehicleId = ? AND location = ?;

-- Deletes all but the latest readings of a tyre
keepLatestByTyreLocationByVehicle:
DELETE FROM Tyre WHERE rowid IN (
    SELECT rowid FROM Tyre
    WHERE vehicleId = ? AND location = ?
    ORDER BY timestamp DESC
    LIMIT -1 OFFSET ?
);

-- Whether the latest reading of any sensor bound to the vehicle reports a voltage, and a percentage
batteryKindsByVehicle:
SELECT
    COALESCE(MAX(batteryVoltage IS NOT NULL), 0) AS hasVoltage,
    COALESCE(MAX(batteryPercent IS NOT NULL), 0) AS hasPercent
FROM Tyre
WHERE Tyre.rowid IN (
    SELECT (
        SELECT latest.rowid FROM Tyre AS latest
        WHERE latest.vehicleId = Sensor.vehicleId AND latest.location = Sensor.location AND latest.id = Sensor.id
        ORDER BY latest.timestamp DESC
        LIMIT 1
    )
    FROM Sensor
    WHERE Sensor.vehicleId = ?
);
